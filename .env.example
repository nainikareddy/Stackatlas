# Copy to .env and fill in. Do NOT commit real secrets (ground rule 08).
# Matches the dockerized DB from `make db-up`.
DSN=postgresql://stackatlas:stackatlas@localhost:5433/vibeshop
# No ANTHROPIC_API_KEY needed: pipeline/docgen.py and the SQL eval runner call
# the LLM via `claude -p` (Claude Code CLI, headless print mode), which
# authenticates with your existing Claude subscription login. Just make sure
# `claude` is installed and logged in (`claude auth`).
STACKATLAS_MODEL=sonnet
